# Copier en .env.prod sur le VPS (jamais commité) et remplir.

# Mot de passe Postgres : générer avec `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Clé d'authentification Tailscale : admin console > Settings > Keys > Generate auth key
# (non réutilisable, non éphémère). Elle ne sert qu'au premier démarrage.
TS_AUTHKEY=

# Optionnel : sans clé, la génération passe uniquement par les règles
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_MS=30000
